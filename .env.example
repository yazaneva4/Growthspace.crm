# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only, bypasses RLS for trusted server operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── Authentication ─────────────────────────────────────────
# GrowthSpace sends its own email verification messages.
# Supabase Auth remains the identity/session backend.
AUTH_EMAIL_HOOK_SECRET=
NEXT_PUBLIC_SITE_URL=

# ── Cloudflare Turnstile ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret

# ── Anthropic (the AI brain) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini (free-tier fallback + Growth AI) ────────
GEMINI_API_KEY=

# ── GPT / OpenAI (Growth AI model option) ──────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ── z.ai / Zhipu GLM ───────────────────────────────────────
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# ── OpenRouter Free Models Router ──────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=openrouter/free

# ── Perplexity (optional, Growth AI live web research) ──
PERPLEXITY_API_KEY=

# ── Meta / WhatsApp & Instagram (webhooks + sending) ──────
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=

# ── GrowthSpace application email ────────────────────
# Separate application transport for invoices, access approvals,
# inbox replies, Growth AI email actions, and authentication verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Or use Gmail SMTP:
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# Shared inbox inbound webhook. Configure your inbound mail provider to POST
# parsed replies to /api/inbox/email/webhook with this header.
INBOX_WEBHOOK_SECRET=

# Google sign-in
NEXT_PUBLIC_GOOGLE_ENABLED=

# ── Voice calls (Twilio) ───────────────────────────────────
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=

# ── ElevenLabs voice (optional) ────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── X (Twitter) publishing (optional) ──────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── OpenCode model provider (optional) ─────────────────────
OPENCODE_API_KEY=

# ── Accepted aliases (optional) ────────────────────────���───
# Google AI Studio key, used if GEMINI_API_KEY is unset.
GOOGLE_API_KEY=
# Alternative name for SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Alternative name for TURNSTILE_SECRET.
TURNSTILE_SECRET_KEY=
# Canonical app origin for the browser-agent allow-list; defaults to SITE_URL.
GROWTHSPACE_SITE_URL=
